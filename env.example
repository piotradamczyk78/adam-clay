# Adam Clay Eden - Zmienne Środowiskowe
# Skopiuj ten plik jako .env i wypełnij własnymi kluczami

# ===== ANTHROPIC API =====
# Klucz do LLM provider LLM API
# Jak uzyskać: https://console.llm-provider.com/
LLM_PROVIDER_API_KEY=your_llm-provider_api_key_here

# ===== SLACK API =====
# Token bota Slack (zaczyna się od xoxb-)
# Jak uzyskać: Zobacz instrukcje w SETUP_INTEGRATIONS.md
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Token aplikacji Slack (zaczyna się od xapp-)
SLACK_APP_TOKEN=xapp-your-slack-app-token-here

# ID kanału Slack gdzie Adam będzie się komunikować
# Jak znaleźć: Kliknij prawym przyciskiem na kanał → "Copy link" → ID jest na końcu URL
SLACK_CHANNEL_ID=C1234567890

# ID użytkownika Slack (Piotr)
# Jak znaleźć: Kliknij na swój profil → "Copy member ID"
SLACK_USER_ID=U1234567890

# ===== BAZA DANYCH =====
# Typ bazy danych: sqlite lub mysql
DATABASE_TYPE=sqlite

# Dla SQLite (proste, lokalne)
DATABASE_PATH=data/eden.db

# Dla MySQL (zaawansowane)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=adam_clay_eden
MYSQL_USERNAME=adam_clay_user
MYSQL_PASSWORD=your_mysql_password_here

# ===== KONFIGURACJA ŚRODOWISKA =====
# Środowisko: development, staging, production
ENVIRONMENT=development

# Poziom logowania: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Ścieżka do logów
LOG_PATH=data/logs/

# ===== OPCJONALNE USTAWIENIA =====
# Timezone (domyślnie: Europe/Warsaw)
TIMEZONE=Europe/Warsaw

# Maksymalny rozmiar logów w MB
MAX_LOG_SIZE_MB=100

# Serwer webhook (opcjonalnie)
WEBHOOK_URL=

# Klucz szyfrowania dla danych wrażliwych (generowany automatycznie jeśli nie podano)
ENCRYPTION_KEY= 