# Adam Clay - Environment Variables Example
# Copy this file to .env and fill in your actual values

# === REQUIRED ===
# LLM provider API Key (required for consciousness)
LLM_PROVIDER_API_KEY=your_llm-provider_api_key_here

# === OPTIONAL COMMUNICATION ===
# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=adam.clay@your-domain.com
SMTP_PASSWORD=your_app_password_here

# Slack integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Discord integration
DISCORD_BOT_TOKEN=your_discord_bot_token

# === OPTIONAL BUSINESS ===
# Stripe for payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# PayPal (alternative)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# === DEVELOPMENT ===
# Debug settings
DEBUG_MODE=false
LOG_LEVEL=INFO
SAVE_ALL_THOUGHTS=true

# Database (optional, defaults to SQLite)
DATABASE_URL=sqlite:///data/adam_clay.db

# === CONSCIOUSNESS SETTINGS ===
# Override config.json values if needed
THINKING_INTERVAL_MINUTES=15
DAILY_BUDGET_REQUESTS=100
MAX_COST_PER_DAY_USD=5.00

# === SECURITY ===
# Secret key for session management
SECRET_KEY=your-very-secret-key-here-change-this

# === MONITORING ===
# Optional monitoring services
SENTRY_DSN=your_sentry_dsn_for_error_tracking
NEWRELIC_LICENSE_KEY=your_newrelic_key 